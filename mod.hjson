#the mod name as displayed in-game
displayName: "Simple Core Mod"

#the internal name of your mod
name: "simple-core-mod"

#your name
author: "srbtef"

#the fully qualified main class of the mod
main: "FusionPlanet.main"

#the mod description as seen in the mod dialog
description: "A Mindustry mod with a simple core block."

#the mod version
version: 1.0

#the minimum game build required to run this mod
minGameVersion: 154

#this is a java mod
java: true
